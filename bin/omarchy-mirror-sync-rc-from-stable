#!/bin/bash
# Give rc the snapshot stable serves, so a patch release candidate is tested
# against exactly what stable users already run and the release ships without
# moving their Arch packages. A feature release takes a fresh snapshot with
# omarchy-mirror-sync-rc instead.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

exec "$SCRIPT_DIR/omarchy-mirror-copy-stage" --from /mnt/arch-mirror-stable/ --to /mnt/arch-mirror-rc/ --r2 omarchy:omarchy-mirror-rc
